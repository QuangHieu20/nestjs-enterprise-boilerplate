{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.json",
    "plugins": ["@nestjs/swagger"],
    "assets": [
      {
        "include": "modules/i18n/infrastructure/catalogs/**/*.json",
        "watchAssets": true
      }
    ]
  }
}
