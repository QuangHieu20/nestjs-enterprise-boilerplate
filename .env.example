# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=nestjs-boilerplate
APP_PORT=3000
API_PREFIX=api/v1
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=auth_db

# Connection URL (alternative to individual fields above)
# DATABASE_URL=postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Message Queue (RabbitMQ) ─────────────────────────────────────────────────
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://${RABBITMQ_USERNAME}:${RABBITMQ_PASSWORD}@localhost:${RABBITMQ_PORT}
RABBITMQ_PREFETCH=1

# ─── Google OAuth ──────────────────────────────────────────────────────────────
# Client ID of the Google OAuth app the frontend uses for Sign in with Google.
# The backend verifies incoming credentials' audience against this value.
GOOGLE_CLIENT_ID=

# ─── i18n ─────────────────────────────────────────────────────────────────────
I18N_HEADER_NAME=x-language-custom
I18N_DEFAULT_LANGUAGE=en

# ─── Rate limiting ───
RATE_LIMIT_TTL=60000   # throttle window in milliseconds
RATE_LIMIT_MAX=100     # max requests per window (global tier)
